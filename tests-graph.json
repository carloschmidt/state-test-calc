{
  "$comment": "Exhaustive graphing calculator tests. Each test sets one expression and checks whether function-plot renders a curve. expectPlot=true means the SVG should contain a path.line. expectPlot=false means the input should be rejected gracefully (no path, no crash). Covers every unary-of-x function from the f(x) library plus boundary, domain, and syntax edge cases.",
  "tests": [
    { "id": "linear",         "category": "valid-basic",   "input": "y=3x+4",            "expectPlot": true },
    { "id": "linear-no-y",    "category": "valid-basic",   "input": "2x+1",              "expectPlot": true },
    { "id": "linear-neg-slope","category":"valid-basic",   "input": "y=-2x+5",           "expectPlot": true },
    { "id": "linear-zero-slope","category":"valid-basic", "input": "y=0\\cdot x+3",     "expectPlot": true, "note": "math.js treats `0x` as a hex prefix; use explicit ·" },
    { "id": "constant",       "category": "valid-basic",   "input": "y=5",               "expectPlot": true },
    { "id": "constant-neg",   "category": "valid-basic",   "input": "y=-7",              "expectPlot": true },
    { "id": "constant-decimal","category": "valid-basic",  "input": "y=2.5",             "expectPlot": true },
    { "id": "constant-pi",    "category": "valid-basic",   "input": "y=\\pi",            "expectPlot": true },
    { "id": "constant-e",     "category": "valid-basic",   "input": "y=e",               "expectPlot": true },
    { "id": "constant-sqrt2", "category": "valid-basic",   "input": "y=\\sqrt{2}",       "expectPlot": true },
    { "id": "constant-frac",  "category": "valid-basic",   "input": "y=\\frac{1}{2}",    "expectPlot": true },
    { "id": "just-x",         "category": "valid-basic",   "input": "x",                 "expectPlot": true },
    { "id": "neg-x",          "category": "valid-basic",   "input": "y=-x",              "expectPlot": true },
    { "id": "double-op",      "category": "valid-basic",   "input": "y=x++5",            "expectPlot": true, "note": "math.js parses ++ as unary plus" },
    { "id": "zero",           "category": "valid-basic",   "input": "y=0",               "expectPlot": true },

    { "id": "parabola",        "category": "valid-poly",    "input": "y=x^2",            "expectPlot": true },
    { "id": "neg-parabola",    "category": "valid-poly",    "input": "y=-x^2",           "expectPlot": true },
    { "id": "shifted-parabola","category":"valid-poly",     "input": "y=(x-2)^2",        "expectPlot": true },
    { "id": "vertex-form",     "category": "valid-poly",    "input": "y=(x-3)^2+1",      "expectPlot": true },
    { "id": "cubic",           "category": "valid-poly",    "input": "y=x^3-2x",         "expectPlot": true },
    { "id": "cubic-neg-lead",  "category": "valid-poly",    "input": "y=-x^3+x",         "expectPlot": true },
    { "id": "quartic",         "category": "valid-poly",    "input": "y=x^4-3x^2+2",     "expectPlot": true },
    { "id": "quintic",         "category": "valid-poly",    "input": "y=x^5-3x^4+2x^3-x+7","expectPlot": true },
    { "id": "factored-quad",   "category": "valid-poly",    "input": "y=(x-1)(x+1)",     "expectPlot": true },
    { "id": "factored-cubic",  "category": "valid-poly",    "input": "y=x\\cdot(x-1)\\cdot(x+1)", "expectPlot": true, "note": "x(...) parses as a function call in math.js; need explicit ·" },
    { "id": "high-degree",     "category": "valid-poly",    "input": "y=x^7",            "expectPlot": true },
    { "id": "leading-coef",    "category": "valid-poly",    "input": "y=3x^4-2x^3+x-5",  "expectPlot": true },

    { "id": "sin",            "category": "valid-trig",    "input": "y=\\sin(x)",        "expectPlot": true },
    { "id": "cos",            "category": "valid-trig",    "input": "y=\\cos(x)",        "expectPlot": true },
    { "id": "tan",            "category": "valid-trig",    "input": "y=\\tan(x)",        "expectPlot": true },
    { "id": "csc",            "category": "valid-trig",    "input": "y=\\csc(x)",        "expectPlot": true },
    { "id": "sec",            "category": "valid-trig",    "input": "y=\\sec(x)",        "expectPlot": true },
    { "id": "cot",            "category": "valid-trig",    "input": "y=\\cot(x)",        "expectPlot": true },
    { "id": "sin-3x",         "category": "valid-trig",    "input": "y=\\sin(3x)",       "expectPlot": true },
    { "id": "sin-x-over-2",   "category": "valid-trig",    "input": "y=\\sin(\\frac{x}{2})","expectPlot": true },
    { "id": "scaled-sin",     "category": "valid-trig",    "input": "y=2\\sin(x)",       "expectPlot": true },
    { "id": "phase-shift",    "category": "valid-trig",    "input": "y=\\sin(x-\\frac{\\pi}{2})","expectPlot": true, "note": "= cos(x)" },
    { "id": "amplitude-period","category":"valid-trig",    "input": "y=3\\sin(2x)",      "expectPlot": true },
    { "id": "shifted-cos",    "category": "valid-trig",    "input": "y=\\cos(x)+1",      "expectPlot": true },
    { "id": "sin-plus-cos",   "category": "valid-trig",    "input": "y=\\sin(x)+\\cos(x)","expectPlot": true },
    { "id": "sin-times-cos",  "category": "valid-trig",    "input": "y=\\sin(x)\\cos(x)","expectPlot": true },
    { "id": "sin-squared",    "category": "valid-trig",    "input": "y=\\sin(x)^2",      "expectPlot": true },

    { "id": "asin",           "category": "valid-inv-trig","input": "y=\\arcsin(x)",     "expectPlot": true },
    { "id": "acos",           "category": "valid-inv-trig","input": "y=\\arccos(x)",     "expectPlot": true },
    { "id": "atan",           "category": "valid-inv-trig","input": "y=\\arctan(x)",     "expectPlot": true },
    { "id": "atan-shifted",   "category": "valid-inv-trig","input": "y=\\arctan(x)+\\frac{\\pi}{2}","expectPlot": true },
    { "id": "acsc",           "category": "valid-inv-trig","input": "y=\\operatorname{acsc}(x)","expectPlot": true },
    { "id": "asec",           "category": "valid-inv-trig","input": "y=\\operatorname{asec}(x)","expectPlot": true },
    { "id": "acot",           "category": "valid-inv-trig","input": "y=\\operatorname{acot}(x)","expectPlot": true },

    { "id": "sinh",           "category": "valid-hyperbolic","input": "y=\\sinh(x)",     "expectPlot": true },
    { "id": "cosh",           "category": "valid-hyperbolic","input": "y=\\cosh(x)",     "expectPlot": true },
    { "id": "tanh",           "category": "valid-hyperbolic","input": "y=\\tanh(x)",     "expectPlot": true },
    { "id": "csch",           "category": "valid-hyperbolic","input": "y=\\operatorname{csch}(x)","expectPlot": true },
    { "id": "sech",           "category": "valid-hyperbolic","input": "y=\\operatorname{sech}(x)","expectPlot": true },
    { "id": "coth",           "category": "valid-hyperbolic","input": "y=\\operatorname{coth}(x)","expectPlot": true },
    { "id": "asinh",          "category": "valid-hyperbolic","input": "y=\\operatorname{asinh}(x)","expectPlot": true },
    { "id": "acosh",          "category": "valid-hyperbolic","input": "y=\\operatorname{acosh}(x)","expectPlot": true },
    { "id": "atanh",          "category": "valid-hyperbolic","input": "y=\\operatorname{atanh}(x)","expectPlot": true },

    { "id": "exp",            "category": "valid-trans",   "input": "y=e^x",             "expectPlot": true },
    { "id": "exp-2x",         "category": "valid-trans",   "input": "y=e^{2x}",          "expectPlot": true },
    { "id": "exp-neg-x",      "category": "valid-trans",   "input": "y=e^{-x}",          "expectPlot": true },
    { "id": "exp-neg-sq",     "category": "valid-trans",   "input": "y=e^{-x^2}",        "expectPlot": true, "note": "bell curve" },
    { "id": "exp-base-2",     "category": "valid-trans",   "input": "y=2^x",             "expectPlot": true },
    { "id": "exp-base-half",  "category": "valid-trans",   "input": "y=(\\frac{1}{2})^x","expectPlot": true },
    { "id": "ln",             "category": "valid-trans",   "input": "y=\\ln(x)",         "expectPlot": true, "note": "only x>0" },
    { "id": "log10",          "category": "valid-trans",   "input": "y=\\log(x)",        "expectPlot": true },
    { "id": "ln-shifted",     "category": "valid-trans",   "input": "y=\\ln(x+1)",      "expectPlot": true, "note": "shifted log" },
    { "id": "sqrt",           "category": "valid-trans",   "input": "y=\\sqrt{x}",       "expectPlot": true },
    { "id": "sqrt-shifted",   "category": "valid-trans",   "input": "y=\\sqrt{x+2}",     "expectPlot": true },
    { "id": "sqrt-neg-x",     "category": "valid-trans",   "input": "y=\\sqrt{-x}",      "expectPlot": true, "note": "only x<=0" },
    { "id": "abs",            "category": "valid-trans",   "input": "y=|x|",             "expectPlot": true },
    { "id": "abs-shifted",    "category": "valid-trans",   "input": "y=|x-3|",           "expectPlot": true },
    { "id": "semicircle",     "category": "valid-trans",   "input": "y=\\sqrt{1-x^2}",   "expectPlot": true },
    { "id": "neg-semicircle", "category": "valid-trans",   "input": "y=-\\sqrt{1-x^2}",  "expectPlot": true },
    { "id": "cube-root",      "category": "valid-trans",   "input": "y=\\sqrt[3]{x}",    "expectPlot": true },
    { "id": "nthroot-5",      "category": "valid-trans",   "input": "y=\\sqrt[5]{x}",    "expectPlot": true },

    { "id": "frac-simple",    "category": "valid-rational","input": "y=\\frac{1}{x}",   "expectPlot": true },
    { "id": "frac-quad",      "category": "valid-rational","input": "y=\\frac{x^2-1}{x+1}","expectPlot": true },
    { "id": "frac-shifted",   "category": "valid-rational","input": "y=\\frac{1}{x-1}", "expectPlot": true },
    { "id": "frac-neg-x",     "category": "valid-rational","input": "y=\\frac{-1}{x}", "expectPlot": true },
    { "id": "frac-x-over-x2", "category": "valid-rational","input": "y=\\frac{x}{x^2+1}","expectPlot": true },
    { "id": "frac-sum",       "category": "valid-rational","input": "y=\\frac{x}{x^2+1}+\\frac{1}{2}","expectPlot": true },
    { "id": "implicit-mult-pi","category":"valid-rational","input": "y=2\\pi x",         "expectPlot": true },
    { "id": "implicit-mult-e","category": "valid-rational","input": "y=e x",            "expectPlot": true, "note": "math.js handles e[space]x as implicit multiplication" },

    { "id": "floor",          "category": "valid-step",    "input": "y=\\operatorname{floor}(x)","expectPlot": true },
    { "id": "ceil",           "category": "valid-step",    "input": "y=\\operatorname{ceil}(x)", "expectPlot": true },
    { "id": "round",          "category": "valid-step",    "input": "y=\\operatorname{round}(x)","expectPlot": true },
    { "id": "mod-2",          "category": "valid-step",    "input": "y=\\operatorname{mod}(x,2)","expectPlot": true },
    { "id": "mod-3",          "category": "valid-step",    "input": "y=\\operatorname{mod}(x,3)","expectPlot": true },

    { "id": "compose-sin-cos","category": "valid-complex", "input": "y=\\sin(\\cos(x))","expectPlot": true },
    { "id": "compose-deep",   "category": "valid-complex", "input": "y=\\sin(\\cos(x^2))","expectPlot": true },
    { "id": "compose-abs-sin","category": "valid-complex", "input": "y=|\\sin(x)|",     "expectPlot": true },
    { "id": "compose-sqrt-abs-sin","category":"valid-complex","input": "y=\\sqrt{|\\sin(x)|}","expectPlot": true },
    { "id": "compose-ln-sq",  "category": "valid-complex", "input": "y=\\ln(x^2+1)",   "expectPlot": true },
    { "id": "compose-exp-neg-sq","category":"valid-complex","input": "y=e^{-x^2/2}",  "expectPlot": true },
    { "id": "compose-mix",    "category": "valid-complex", "input": "y=x\\cdot\\sin(x)","expectPlot": true, "note": "x\\sin without explicit · parses as identifier `xsin`" },
    { "id": "compose-mix-2",  "category": "valid-complex", "input": "y=\\frac{\\sin(x)}{x}","expectPlot": true, "note": "sinc function" },
    { "id": "compose-power-trig","category":"valid-complex","input": "y=\\sin(x)^2+\\cos(x)^2","expectPlot": true, "note": "= 1" },

    { "id": "empty",          "category": "invalid-empty", "input": "",                  "expectPlot": false },
    { "id": "y-equals",       "category": "invalid-empty", "input": "y=",                "expectPlot": false },
    { "id": "y-spaced",       "category": "invalid-empty", "input": "y = ",              "expectPlot": false },
    { "id": "just-y",         "category": "invalid-empty", "input": "y",                 "expectPlot": false },
    { "id": "just-equals",    "category": "invalid-empty", "input": "=",                 "expectPlot": false },
    { "id": "spaces",         "category": "invalid-empty", "input": "   ",               "expectPlot": false },
    { "id": "newline",        "category": "invalid-empty", "input": "\\n",               "expectPlot": false },

    { "id": "undef-var-z",    "category": "valid-slider",  "input": "y=z+1",             "expectPlot": true,  "note": "z auto-slider at default 1 → y=2" },
    { "id": "undef-var-a",    "category": "valid-slider",  "input": "y=a",               "expectPlot": true,  "note": "a auto-slider → constant line" },
    { "id": "two-vars",       "category": "valid-slider",  "input": "y=x+z",             "expectPlot": true,  "note": "z auto-slider → y=x+1" },
    { "id": "all-vars",       "category": "valid-slider",  "input": "y=a+b+c",           "expectPlot": true,  "note": "all auto-sliders → constant line" },
    { "id": "unknown-fn",     "category": "invalid-vars",  "input": "y=\\operatorname{blah}(x)", "expectPlot": false },
    { "id": "normaldist-pdf", "category": "valid-trans",   "input": "y=\\operatorname{normaldist}(x,0,1)", "expectPlot": true, "note": "standard normal pdf" },
    { "id": "no-x",           "category": "valid-slider",  "input": "y=z",               "expectPlot": true,  "note": "z auto-slider → constant line" },

    { "id": "leading-op-mul", "category": "invalid-syntax","input": "y=*5",              "expectPlot": false },
    { "id": "leading-op-div", "category": "invalid-syntax","input": "y=/5",              "expectPlot": false },
    { "id": "trailing-op-plus","category":"invalid-syntax","input": "y=x+",              "expectPlot": false },
    { "id": "trailing-op-mul","category":"invalid-syntax", "input": "y=x*",              "expectPlot": false },
    { "id": "unbalanced-paren","category":"invalid-syntax","input": "y=(x+1",            "expectPlot": false },
    { "id": "unbalanced-paren-r","category":"invalid-syntax","input": "y=x+1)",          "expectPlot": false },
    { "id": "lonely-paren",   "category": "invalid-syntax","input": "y=)",               "expectPlot": false },
    { "id": "double-dot",     "category": "invalid-syntax","input": "y=3..14",           "expectPlot": false },
    { "id": "triple-op",      "category": "valid-basic",   "input": "y=x+++5",           "expectPlot": true, "note": "math.js parses chained +s as unary plus" },
    { "id": "empty-parens",   "category": "invalid-syntax","input": "y=x+()",            "expectPlot": false },
    { "id": "unfilled-frac",  "category": "invalid-syntax","input": "y=\\frac{1}{\\placeholder{}}", "expectPlot": false },
    { "id": "unfilled-sqrt",  "category": "invalid-syntax","input": "y=\\sqrt{\\placeholder{}}",    "expectPlot": false },
    { "id": "unfilled-pow",   "category": "invalid-syntax","input": "y=x^{\\placeholder{}}",        "expectPlot": false },
    { "id": "unfilled-trig",  "category": "invalid-syntax","input": "y=\\sin\\left(\\placeholder{}\\right)", "expectPlot": false },

    { "id": "div-by-zero",    "category": "invalid-domain","input": "y=1/0",             "expectPlot": false },
    { "id": "zero-over-zero", "category": "invalid-domain","input": "y=0/0",             "expectPlot": false },
    { "id": "neg-div-zero",   "category": "invalid-domain","input": "y=-3/0",            "expectPlot": false },
    { "id": "log-of-neg-const","category":"invalid-domain","input": "y=\\ln(-1)",       "expectPlot": false },
    { "id": "sqrt-of-neg-const","category":"invalid-domain","input": "y=\\sqrt{-1}",   "expectPlot": false },

    { "id": "inequality-gt",  "category": "valid-inequality", "input": "y>x",               "expectPlot": true, "note": "wired via closed-fill" },
    { "id": "inequality-ge",  "category": "valid-inequality", "input": "y\\ge x",           "expectPlot": true },
    { "id": "inequality-lt",  "category": "valid-inequality", "input": "y<x^2",             "expectPlot": true },
    { "id": "inequality-le",  "category": "valid-inequality", "input": "y\\le x^2",         "expectPlot": true },
    { "id": "implicit-circle","category": "valid-implicit",   "input": "x^2+y^2=25",        "expectPlot": true, "note": "wired via fnType:implicit" },
    { "id": "standard-linear","category": "valid-implicit",   "input": "2x+3y=6",           "expectPlot": true, "note": "standard form Ax+By=C" },
    { "id": "standard-linear-neg","category":"valid-implicit","input": "3y-x=4",            "expectPlot": true },
    { "id": "standard-linear-floats","category":"valid-implicit","input": "0.5x+2y=10",     "expectPlot": true },
    { "id": "ellipse-implicit","category":"valid-implicit",   "input": "x^2/4+y^2/9=1",     "expectPlot": true, "note": "ellipse" },
    { "id": "hyperbola-implicit","category":"valid-implicit", "input": "xy=1",              "expectPlot": true, "note": "hyperbola" },
    { "id": "coord-point",    "category": "valid-points",     "input": "(1,2)",             "expectPlot": true, "note": "rendered as SVG circle" },
    { "id": "coord-point-neg","category": "valid-points",     "input": "(-3,4)",            "expectPlot": true },
    { "id": "coord-point-decimal","category":"valid-points",  "input": "(1.5,-2.5)",        "expectPlot": true },
    { "id": "coord-mathlive-parens","category":"valid-points","input": "\\left(1,2\\right)","expectPlot": true },

    { "id": "param-circle",     "category": "valid-parametric", "input": "(\\cos(t),\\sin(t))",                                                              "expectPlot": true },
    { "id": "param-ellipse",    "category": "valid-parametric", "input": "(2\\cos(t),3\\sin(t))",                                                            "expectPlot": true },
    { "id": "param-line",       "category": "valid-parametric", "input": "(t,2t+1)",                                                                          "expectPlot": true },
    { "id": "param-lissajous",  "category": "valid-parametric", "input": "(\\sin(3t),\\cos(2t))",                                                             "expectPlot": true },
    { "id": "param-spiral",     "category": "valid-parametric", "input": "(t\\cdot\\cos(t),t\\cdot\\sin(t))",                                                  "expectPlot": true },
    { "id": "param-still-point","category": "valid-parametric", "input": "(3,4)",                                                                             "expectPlot": true, "note": "no t → still a point" },
    { "id": "param-bad-symbol", "category": "valid-parametric", "input": "(\\cos(z),\\sin(z))",                                                               "expectPlot": false, "note": "z is undefined" },

    { "id": "polygon-triangle", "category": "valid-polygon", "input": "polygon((0,0),(2,0),(1,2))",                                                            "expectPlot": true },
    { "id": "polygon-square",   "category": "valid-polygon", "input": "polygon((0,0),(1,0),(1,1),(0,1))",                                                      "expectPlot": true },
    { "id": "polygon-hex",      "category": "valid-polygon", "input": "polygon((1,0),(0.5,0.87),(-0.5,0.87),(-1,0),(-0.5,-0.87),(0.5,-0.87))",                "expectPlot": true },
    { "id": "polygon-line",     "category": "valid-polygon", "input": "polygon((0,0),(3,3))",                                                                  "expectPlot": true, "note": "2 points → line segment" },
    { "id": "polygon-empty",    "category": "valid-polygon", "input": "polygon()",                                                                             "expectPlot": false },
    { "id": "polygon-malformed","category": "valid-polygon", "input": "polygon((0,0),(1,))",                                                                   "expectPlot": false },

    { "id": "piece-pos",        "category": "valid-piecewise", "input": "y=x^2\\{x>0\\}",                                                                       "expectPlot": true },
    { "id": "piece-bounded",    "category": "valid-piecewise", "input": "y=x^2\\{-2<x<2\\}",                                                                    "expectPlot": true },
    { "id": "piece-le",         "category": "valid-piecewise", "input": "y=\\sin(x)\\{x\\le\\pi\\}",                                                            "expectPlot": true },
    { "id": "piece-and",        "category": "valid-piecewise", "input": "y=x\\{x>0 \\text{ and } x<5\\}",                                                       "expectPlot": true },
    { "id": "piece-empty-range","category": "valid-piecewise", "input": "y=x\\{x>5 \\text{ and } x<0\\}",                                                       "expectPlot": false, "note": "contradictory range" },

    { "id": "deriv-poly",    "category": "valid-deriv", "input": "y=\\frac{d}{dx}(x^2)",                                                                       "expectPlot": true, "note": "→ 2x" },
    { "id": "deriv-trig",    "category": "valid-deriv", "input": "y=\\frac{d}{dx}(\\sin(x))",                                                                  "expectPlot": true },
    { "id": "deriv-product", "category": "valid-deriv", "input": "y=\\frac{d}{dx}(x\\cdot\\sin(x))",                                                           "expectPlot": true },
    { "id": "deriv-const",   "category": "valid-deriv", "input": "y=\\frac{d}{dx}(5)",                                                                         "expectPlot": true, "note": "→ 0, flat line" },
    { "id": "deriv-bad",     "category": "valid-deriv", "input": "y=\\frac{d}{dx}(z+1)",                                                                       "expectPlot": false, "note": "z is not the integration variable" },

    { "id": "slider-linear",  "category": "valid-slider", "input": "y=m\\cdot x+b",                                                                            "expectPlot": true, "note": "m,b auto-slider at default value 1" },
    { "id": "slider-amp",     "category": "valid-slider", "input": "y=a\\cdot\\sin(x)",                                                                        "expectPlot": true, "note": "a auto-slider" },
    { "id": "slider-two",     "category": "valid-slider", "input": "y=k_{1}\\cdot x+k_{2}",                                                                    "expectPlot": true, "note": "subscripted slider names" },

    { "id": "table-no-table",  "category": "valid-table", "input": "(x_{1},y_{1})",                                                                            "expectPlot": false, "note": "no table defined → reject" },

    { "id": "param-trig-id",      "category": "valid-parametric", "input": "(\\sin(t)^2,\\cos(t)^2)",                                                            "expectPlot": true, "note": "should plot, the identity x+y=1 is a line segment" },
    { "id": "param-mixed-const",  "category": "valid-parametric", "input": "(2,\\sin(t))",                                                                       "expectPlot": true, "note": "x constant, y oscillates → vertical segment" },
    { "id": "param-tan",          "category": "valid-parametric", "input": "(t,\\tan(t))",                                                                       "expectPlot": true, "note": "vertical asymptotes — should still render some segments" },
    { "id": "param-exp",          "category": "valid-parametric", "input": "(t,e^t)",                                                                            "expectPlot": true, "note": "exponential growth" },
    { "id": "param-rational",     "category": "valid-parametric", "input": "(\\frac{1}{t},t)",                                                                   "expectPlot": true, "note": "singularity at t=0; non-zero samples must yield finite" },
    { "id": "param-stripped-parens","category":"valid-parametric","input": "\\left(\\cos(t),\\sin(t)\\right)",                                                  "expectPlot": true, "note": "mathlive \\left/\\right wrapping" },
    { "id": "param-zero",         "category": "valid-parametric", "input": "(0,t)",                                                                              "expectPlot": true, "note": "x always zero → vertical line; valid parametric" },
    { "id": "param-no-t-undef",   "category": "valid-parametric", "input": "(s,t)",                                                                              "expectPlot": false, "note": "s is not a recognized parameter" },

    { "id": "polygon-single",     "category": "valid-polygon", "input": "polygon((5,5))",                                                                       "expectPlot": false, "note": "1 point < min 2 for polygon" },
    { "id": "polygon-many",       "category": "valid-polygon", "input": "polygon((0,0),(1,0),(2,0),(2,1),(2,2),(1,2),(0,2),(0,1))",                            "expectPlot": true, "note": "octagonal closed shape" },
    { "id": "polygon-negs",       "category": "valid-polygon", "input": "polygon((-3,-3),(3,-3),(3,3),(-3,3))",                                                 "expectPlot": true, "note": "all-negative quadrant" },
    { "id": "polygon-spaces",     "category": "valid-polygon", "input": "polygon(  (0, 0),  (1, 1)  )",                                                         "expectPlot": true, "note": "extra whitespace inside the call" },
    { "id": "polygon-decimal-coords","category":"valid-polygon","input": "polygon((0.1,0.1),(0.9,0.1),(0.5,0.9))",                                              "expectPlot": true },
    { "id": "polygon-trailing-junk","category":"valid-polygon", "input": "polygon((0,0),(1,1)x)",                                                                "expectPlot": false, "note": "trailing junk after points → reject" },

    { "id": "piece-ge-zero",      "category": "valid-piecewise", "input": "y=x\\{x\\ge 0\\}",                                                                    "expectPlot": true },
    { "id": "piece-neg-bound",    "category": "valid-piecewise", "input": "y=x^2\\{x<-1\\}",                                                                      "expectPlot": true, "note": "x < -1" },
    { "id": "piece-pi-bound",     "category": "valid-piecewise", "input": "y=\\cos(x)\\{-\\pi<x<\\pi\\}",                                                        "expectPlot": true, "note": "uses \\pi in both bounds" },
    { "id": "piece-bad-cond",     "category": "valid-piecewise", "input": "y=x\\{abc\\}",                                                                        "expectPlot": false, "note": "condition not a real inequality" },
    { "id": "piece-equals-bound", "category": "valid-piecewise", "input": "y=x\\{x=0\\}",                                                                        "expectPlot": false, "note": "equality is not a range" },
    { "id": "piece-no-x-in-cond", "category": "valid-piecewise", "input": "y=x\\{5>0\\}",                                                                        "expectPlot": false, "note": "condition doesn't reference x" },

    { "id": "deriv-chain-rule",   "category": "valid-deriv", "input": "y=\\frac{d}{dx}(\\sin(x^2))",                                                            "expectPlot": true, "note": "→ 2x cos(x^2)" },
    { "id": "deriv-exp",          "category": "valid-deriv", "input": "y=\\frac{d}{dx}(e^x)",                                                                    "expectPlot": true, "note": "→ e^x" },
    { "id": "deriv-log",          "category": "valid-deriv", "input": "y=\\frac{d}{dx}(\\ln(x))",                                                                "expectPlot": true, "note": "→ 1/x" },
    { "id": "deriv-quotient",     "category": "valid-deriv", "input": "y=\\frac{d}{dx}(\\frac{x}{x+1})",                                                        "expectPlot": true, "note": "→ 1/(x+1)^2" },
    { "id": "deriv-pi-const",     "category": "valid-deriv", "input": "y=\\frac{d}{dx}(\\pi)",                                                                  "expectPlot": true, "note": "→ 0" },
    { "id": "deriv-with-e",       "category": "valid-deriv", "input": "y=\\frac{d}{dx}(e\\cdot x)",                                                             "expectPlot": true, "note": "→ e (constant)" },

    { "id": "slider-neg-default", "category": "valid-slider", "input": "y=-c\\cdot x",                                                                          "expectPlot": true, "note": "slider c→1; line slope -1" },
    { "id": "slider-three",       "category": "valid-slider", "input": "y=a\\cdot x^2+b\\cdot x+c",                                                             "expectPlot": true, "note": "general quadratic; 3 sliders" },
    { "id": "slider-implicit",    "category": "valid-implicit", "input": "x^2+y^2=r^2",                                                                         "expectPlot": true,  "note": "r auto-slider in implicit branch" },
    { "id": "slider-inequality",  "category": "valid-inequality", "input": "y>m\\cdot x",                                                                       "expectPlot": true,  "note": "m auto-slider in inequality branch" }
  ]
}
